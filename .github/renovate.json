{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "enabled": true
    },
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    }
  ],
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>"
}
